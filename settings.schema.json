// Elite's settings: types, ranges, defaults, words and pages.
{
  "schema": 1,
  "settings": {
    "journal_dir": {
      "type": "path",
      "default": "",
      "role": "path",
      "restart": "session",
      "label": "Journal folder",
      "help": "Where Elite writes its journal and Status.json. Empty: Elite's standard folder. Applies with Apply now.",
      "placeholder": "Elite's standard folder"
    },
    "bindings_dir": {
      "type": "path",
      "default": "",
      "role": "path",
      "restart": "session",
      "label": "Bindings folder",
      "help": "Where Elite keeps your control presets. Empty: Elite's standard folder. Applies with Apply now.",
      "placeholder": "Elite's standard folder"
    },
    "haptics_gain": {
      "type": "map",
      "role": "feel_gain",
      "needs": "haptics",
      "of": { "type": "float", "min": 0, "max": 2, "step": 0.05, "unit": "%", "scale": 100 },
      "default": {
        "fire_primary": 1,
        "fire_secondary": 1,
        "spin_up": 1,
        "rail_crack": 1,
        "missile_launch": 1,
        "reload": 1,
        "reload_done": 1,
        "thrust": 1,
        "thrust_low": 1,
        "boost": 1,
        "boost_empty": 1,
        "maneuver": 1,
        "maneuver_kick": 1,
        "fa_off": 1,
        "fa_on": 1,
        "hardpoints": 1,
        "landing_gear": 1,
        "cargo_scoop": 1,
        "silent_running": 1,
        "pips": 1,
        "fire_group": 1,
        "target_locked": 1,
        "heat_sink": 1,
        "chaff": 1,
        "shield_cell": 1,
        "ecm": 1,
        "scanner": 1,
        "utility": 1,
        "limpet": 1,
        "heat_build": 1,
        "heat_warning": 1,
        "heat_damage": 1,
        "heat_notch": 1,
        "overheat": 1,
        "fsd_charge": 1,
        "fsd_ready": 1,
        "hyperspace": 1,
        "supercruise_in": 1,
        "supercruise_out": 1,
        "mass_lock": 1,
        "mass_unlock": 1,
        "interdicted": 1,
        "interdiction": 1,
        "interdiction_noise": 1,
        "escaped": 1,
        "jet_cone": 1,
        "fuel_scoop": 1,
        "honk": 1,
        "docked": 1,
        "undocked": 1,
        "touchdown": 1,
        "liftoff": 1,
        "vehicle": 1,
        "docking_granted": 1,
        "glide": 1,
        "glide_low": 1,
        "glide_start": 1,
        "glide_end": 1,
        "ground_rush": 1,
        "shields_down": 1,
        "shields_up": 1,
        "shields_offline": 1,
        "shield_hit": 1,
        "shield_low": 1,
        "shield_regen": 1,
        "hull_hit": 1,
        "hull_hit_hud": 1,
        "hull_creak": 1,
        "hull_breach": 1,
        "under_attack": 1,
        "kill": 1,
        "died": 1,
        "scanned": 1,
        "target_hit": 1,
        "target_hull_hit": 1,
        "target_shield_break": 1,
        "cargo_collect": 1,
        "cargo_eject": 1,
        "message": 1,
        "thargoid": 1,
        "thargoid_pulse": 1,
        "systems_shutdown": 1,
        "systems_reboot": 1,
        "shot_kinetic": 1,
        "shot_laser": 1,
        "shot_plasma": 1,
        "onfoot_shot": 1
      },
      "label": "Effect levels",
      "help": "The level of each effect. 100% is normal, 0% turns it off.",
      "groups": {
        "flying": { "title": "Weapons and flying", "order": 1 },
        "systems": { "title": "Ship systems", "order": 2 },
        "travel": { "title": "Travel", "order": 3 },
        "planets": { "title": "Planets and stations", "order": 4 },
        "combat": { "title": "Combat", "order": 5 },
        "rest": { "title": "Cargo, Thargoids and on foot", "order": 6 }
      },
      "entries": {
        "fire_primary": { "label": "Primary fire", "help": "R2's weapons while you fire.", "group": "flying" },
        "fire_secondary": { "label": "Secondary fire", "help": "L2's weapons while you fire.", "group": "flying" },
        "spin_up": { "label": "Multi-cannon spin-up", "help": "The whir before multi-cannons fire.", "group": "flying" },
        "rail_crack": { "label": "Railgun crack", "help": "The crack when a railgun fires.", "group": "flying" },
        "missile_launch": { "label": "Missile launch", "help": "A thump for each missile press.", "group": "flying" },
        "reload": { "label": "Clip out", "help": "A double clack when a clip drops out (HUD).", "group": "flying" },
        "reload_done": { "label": "Clip in", "help": "A heavy thunk when a clip seats (HUD).", "group": "flying" },
        "thrust": { "label": "Thrust", "help": "A light rumble while R1 is held.", "group": "flying" },
        "thrust_low": { "label": "Thrust, low layer", "help": "The deep layer under thrust.", "group": "flying" },
        "boost": { "label": "Boost", "help": "The surge of a boost.", "group": "flying" },
        "boost_empty": { "label": "Boost without charge", "help": "A hollow dud when the engine capacitor is too low (HUD).", "group": "flying" },
        "maneuver": { "label": "Turns", "help": "The turn feel.", "group": "flying" },
        "maneuver_kick": { "label": "Flick", "help": "A soft push on a sudden flick of the controller.", "group": "flying" },
        "fa_off": { "label": "Flight assist off", "help": "A click when flight assist goes off.", "group": "flying" },
        "fa_on": { "label": "Flight assist on", "help": "A click when flight assist comes back.", "group": "flying" },
        "hardpoints": { "label": "Hardpoints", "help": "Deploying or retracting the hardpoints.", "group": "systems" },
        "landing_gear": { "label": "Landing gear", "help": "Lowering or raising the landing gear.", "group": "systems" },
        "cargo_scoop": { "label": "Cargo scoop", "help": "Opening or closing the cargo scoop.", "group": "systems" },
        "silent_running": { "label": "Silent running", "help": "Silent running on or off.", "group": "systems" },
        "pips": { "label": "Pips", "help": "Moving power between systems.", "group": "systems" },
        "fire_group": { "label": "Fire group", "help": "Changing the fire group.", "group": "systems" },
        "target_locked": { "label": "Target lock", "help": "Locking a target.", "group": "systems" },
        "heat_sink": { "label": "Heat sink", "help": "Firing a heat sink.", "group": "systems" },
        "chaff": { "label": "Chaff", "help": "Firing chaff.", "group": "systems" },
        "shield_cell": { "label": "Shield cell", "help": "Using a shield cell.", "group": "systems" },
        "ecm": { "label": "ECM", "help": "Firing the ECM.", "group": "systems" },
        "scanner": { "label": "Scanners", "help": "A hum while a scanner is held.", "group": "systems" },
        "utility": { "label": "Other utilities", "help": "A click for the other utilities.", "group": "systems" },
        "limpet": { "label": "Limpets", "help": "Launching a limpet.", "group": "systems" },
        "heat_build": { "label": "Heat", "help": "A slow throb above about 40% heat that speeds up as heat rises.", "group": "systems" },
        "heat_warning": { "label": "Heat warning", "help": "Elite's heat warning.", "group": "systems" },
        "heat_damage": { "label": "Heat damage", "help": "Damage from heat.", "group": "systems" },
        "heat_notch": { "label": "Heat steps", "help": "A thud at 60% heat and at every 10% after (HUD).", "group": "systems" },
        "overheat": { "label": "Overheating", "help": "Boiling while overheating.", "group": "systems" },
        "fsd_charge": { "label": "FSD charge", "help": "The soft pulse of the Calm jump feel.", "group": "travel" },
        "fsd_ready": { "label": "FSD ready", "help": "The FSD is ready to jump.", "group": "travel" },
        "hyperspace": { "label": "Hyperspace swell", "help": "The swell into the hyperspace tunnel.", "group": "travel" },
        "supercruise_in": { "label": "Supercruise entry", "help": "Entering supercruise.", "group": "travel" },
        "supercruise_out": { "label": "Supercruise drop", "help": "Dropping out of supercruise.", "group": "travel" },
        "mass_lock": { "label": "Mass lock", "help": "Mass locked.", "group": "travel" },
        "mass_unlock": { "label": "Mass lock clear", "help": "The mass lock ends.", "group": "travel" },
        "interdicted": { "label": "Interdicted", "help": "An interdiction pulls you out.", "group": "travel" },
        "interdiction": { "label": "Interdiction", "help": "The pull while you are interdicted.", "group": "travel" },
        "interdiction_noise": { "label": "Interdiction noise", "help": "The noise layer of the interdiction.", "group": "travel" },
        "escaped": { "label": "Escaped", "help": "Escaping an interdiction.", "group": "travel" },
        "jet_cone": { "label": "Jet cone boost", "help": "A jet cone boost.", "group": "travel" },
        "fuel_scoop": { "label": "Fuel scooping", "help": "While you scoop fuel.", "group": "travel" },
        "honk": { "label": "FSS honk", "help": "The discovery scanner's honk.", "group": "travel" },
        "docked": { "label": "Docked", "help": "The docking clamps.", "group": "planets" },
        "undocked": { "label": "Undocked", "help": "Leaving the pad.", "group": "planets" },
        "touchdown": { "label": "Touchdown", "help": "Landing on a planet.", "group": "planets" },
        "liftoff": { "label": "Liftoff", "help": "Lifting off a planet.", "group": "planets" },
        "vehicle": { "label": "SRV and fighter", "help": "Launching or docking an SRV or a fighter.", "group": "planets" },
        "docking_granted": { "label": "Docking granted", "help": "Docking permission granted.", "group": "planets" },
        "glide": { "label": "Glide", "help": "The glide into a planet.", "group": "planets" },
        "glide_low": { "label": "Glide, low layer", "help": "The deep layer under the glide.", "group": "planets" },
        "glide_start": { "label": "Atmosphere", "help": "Hitting the atmosphere.", "group": "planets" },
        "glide_end": { "label": "Glide end", "help": "Leaving the glide.", "group": "planets" },
        "ground_rush": { "label": "Ground rush", "help": "Dropping fast below 2500 m.", "group": "planets" },
        "shields_down": { "label": "Shields down", "help": "The shields break: a long falling sweep, fading crackle and a dead thud.", "group": "combat" },
        "shields_up": { "label": "Shields up", "help": "The shields come back.", "group": "combat" },
        "shields_offline": { "label": "Shields offline", "help": "A low rattle while the shields are down.", "group": "combat" },
        "shield_hit": {
          "label": "Shield hit",
          "help": "A push on the side that was hit, longer and stronger the more shield it took (HUD).",
          "group": "combat"
        },
        "shield_low": { "label": "Shields low", "help": "A crackle at 40% shields or less (HUD).", "group": "combat" },
        "shield_regen": { "label": "Shields refilling", "help": "Ticks while the shields refill (HUD).", "group": "combat" },
        "hull_hit": { "label": "Hull hit", "help": "Hull damage from the journal.", "group": "combat" },
        "hull_hit_hud": { "label": "Hull hit (HUD)", "help": "A heavy blow on each hull drop the HUD shows.", "group": "combat" },
        "hull_creak": { "label": "Hull creak", "help": "Below 30% hull (HUD).", "group": "combat" },
        "hull_breach": { "label": "Cockpit breach", "help": "The canopy breaks.", "group": "combat" },
        "under_attack": { "label": "Under attack", "help": "Elite says you are under attack.", "group": "combat" },
        "kill": { "label": "Kill", "help": "A kill, bounty or combat bond.", "group": "combat" },
        "died": { "label": "Death", "help": "Your ship is destroyed.", "group": "combat" },
        "scanned": { "label": "Scanned", "help": "A scan line from the left grip to the right when a ship scans you.", "group": "combat" },
        "target_hit": { "label": "Your hits", "help": "A tick when your shots land (HUD).", "group": "combat" },
        "target_hull_hit": { "label": "Your hull hits", "help": "Deeper, once the target's shields are down (HUD).", "group": "combat" },
        "target_shield_break": { "label": "Target shields down", "help": "A shatter when the target's shields collapse (HUD).", "group": "combat" },
        "cargo_collect": { "label": "Cargo scooped", "help": "Scooping cargo.", "group": "rest" },
        "cargo_eject": { "label": "Cargo ejected", "help": "Ejecting cargo.", "group": "rest" },
        "message": { "label": "Messages", "help": "Messages from players or your wing.", "group": "rest" },
        "thargoid": { "label": "Thargoids", "help": "A slow throb while their music plays.", "group": "rest" },
        "thargoid_pulse": { "label": "Thargoid pulse", "help": "The noise layer of that throb.", "group": "rest" },
        "systems_shutdown": { "label": "Shutdown field", "help": "A Thargoid shutdown field powers everything down.", "group": "rest" },
        "systems_reboot": { "label": "Reboot", "help": "The systems come back.", "group": "rest" },
        "shot_kinetic": { "label": "On foot: kinetic", "help": "Each shot of a kinetic weapon on foot.", "group": "rest" },
        "shot_laser": { "label": "On foot: laser", "help": "Each shot of a laser weapon on foot.", "group": "rest" },
        "shot_plasma": { "label": "On foot: plasma", "help": "Each shot of a plasma weapon on foot.", "group": "rest" },
        "onfoot_shot": { "label": "On foot: rumble", "help": "A shot on foot with the rumble fallback.", "group": "rest" }
      }
    },
    "turn_feel": {
      "type": "enum",
      "default": "waves",
      "needs": "haptics",
      "label": "Turn feel",
      "help": "Waves: a soft swell about every 2 seconds while the ship turns.",
      "options": { "waves": "Waves", "push": "Push", "off": "Off" },
      "by_value": {
        "waves": "Waves: a soft swell about every 2 seconds while the ship turns.",
        "push": "Push: a soft push when a turn starts, changes or ends.",
        "off": "Off: nothing."
      }
    },
    "jump_feel": {
      "type": "enum",
      "default": "swell",
      "needs": "haptics",
      "label": "Jump feel",
      "help": "Swell: one soft swell into the hyperspace tunnel.",
      "options": { "swell": "Swell", "calm": "Calm", "off": "Off" },
      "by_value": {
        "swell": "Swell: one soft swell into the hyperspace tunnel.",
        "calm": "Calm: the swell, and a soft pulse every second while the FSD charges.",
        "off": "Off: nothing."
      }
    },
    "fire_groups": {
      "type": "map",
      "needs": "haptics",
      "label": "Fire groups",
      "help": "The weapon feel per fire group. Auto uses what the HUD showed for that group, else a guess from your loadout. A group not listed here is Auto.",
      "entry_label": "Fire group {key}",
      "entry_help": "Auto: the weapon the HUD shows for this group.",
      "key": { "type": "int", "min": 1, "max": 99 },
      "of": {
        "type": "record",
        "fields": {
          "primary": {
            "type": "enum",
            "label": "R2",
            "options": {
              "auto": "Auto",
              "beam": "Beam laser",
              "pulse": "Pulse laser",
              "burst": "Burst laser",
              "multicannon": "Multi-cannon",
              "cannon": "Cannon",
              "fragment": "Fragment cannon",
              "railgun": "Railgun",
              "plasma": "Plasma accelerator",
              "missile": "Missiles",
              "mining": "Mining laser",
              "generic": "Generic"
            }
          },
          "secondary": {
            "type": "enum",
            "label": "L2",
            "options": {
              "auto": "Auto",
              "beam": "Beam laser",
              "pulse": "Pulse laser",
              "burst": "Burst laser",
              "multicannon": "Multi-cannon",
              "cannon": "Cannon",
              "fragment": "Fragment cannon",
              "railgun": "Railgun",
              "plasma": "Plasma accelerator",
              "missile": "Missiles",
              "mining": "Mining laser",
              "generic": "Generic"
            }
          }
        }
      },
      "default": {
        "1": { "primary": "auto", "secondary": "auto" },
        "2": { "primary": "auto", "secondary": "auto" }
      }
    },
    "spin_up_ms": {
      "type": "map",
      "needs": "haptics",
      "clamp": "file",
      "label": "Multi-cannon spin-up",
      "help": "How long multi-cannons spin up before they fire, by hardpoint size. If the rattle starts before or after your guns, change the size you fly.",
      "of": { "type": "int", "min": 0, "max": 5000, "step": 50, "unit": "ms" },
      "default": { "small": 250, "medium": 500, "large": 1500, "huge": 0 },
      "entries": {
        "small": { "label": "Small" },
        "medium": { "label": "Medium" },
        "large": { "label": "Large" },
        "huge": { "label": "Huge" }
      }
    },
    "gyro_off_gui_focus": {
      "type": "intset",
      "min": 1,
      "max": 11,
      "needs": "gyro",
      "default": [1, 2, 3, 4, 5, 6, 7, 8, 11],
      "label": "Panels with the gyro off",
      "help": "The main menu is always included.",
      "entries": {
        "1": { "label": "Right panel" },
        "2": { "label": "Left panel" },
        "3": { "label": "Comms panel" },
        "4": { "label": "Role panel" },
        "5": { "label": "Station services" },
        "6": { "label": "Galaxy map" },
        "7": { "label": "System map" },
        "8": { "label": "Orrery" },
        "9": { "label": "FSS" },
        "10": { "label": "Surface scanner" },
        "11": { "label": "Codex" }
      }
    },
    "hud_reader": {
      "type": "bool",
      "default": true,
      "needs": "screen",
      "label": "HUD reader",
      "row": "Read the cockpit HUD",
      "help": "Shields, heat and fire groups from your screen. Run Elite borderless or windowed."
    },
    "hud_debug": {
      "type": "bool",
      "default": false,
      "needs": "screen",
      "label": "Save HUD captures",
      "help": "Small pictures of the HUD, for a problem report.",
      "confirm": {
        "title": "Save HUD captures?",
        "text": "Bururu saves small screen captures of the HUD to the hud_debug folder while it reads the HUD. They show what was on your screen. Turn this off when you are done.",
        "ok": "Save captures"
      }
    },
    "hud_colors": {
      "type": "map",
      "needs": "screen",
      "of": { "type": "hex" },
      "default": {},
      "label": "HUD colours",
      "help": "An empty colour is automatic: Bururu learns it from your screen, else uses your colour matrix, else Elite's standard colour. Set colours here for EDHM themes or filters.",
      "entries": {
        "shield": { "label": "Shield %", "help": "The shield % and the ship hologram. Setting it stops the learning.", "placeholder": "#29c8cf" },
        "heat": { "label": "Heat %", "help": "The heat %. Setting it stops the learning.", "placeholder": "#ba6c16" },
        "hull": { "label": "HUD main colour", "help": "The hull %, the capacitors and the weapon lists.", "placeholder": "#d6870c" },
        "flame": { "label": "Heat icon", "help": "The heat icon, and out-of-range weapons.", "placeholder": "#931e1b" },
        "flash": {
          "label": "Hit flashes",
          "help": "Hit flashes on the hologram. Off: hits are felt from the shield % dropping.",
          "placeholder": "#3862c1",
          "also": ["off"]
        }
      }
    },
    "colors": {
      "type": "map",
      "role": "color_table",
      "needs": "lightbar",
      "of": { "type": "rgb", "min": 0, "max": 255 },
      "default": {
        "hull_full": [0, 255, 60],
        "hull_half": [255, 190, 0],
        "hull_low": [255, 0, 0],
        "supercruise": [30, 80, 255],
        "hyperspace": [140, 170, 255],
        "fsd_charge": [255, 255, 255],
        "fuel_scoop": [255, 150, 0],
        "interdiction": [255, 0, 200],
        "jet_cone": [0, 255, 255],
        "shields_down": [255, 0, 0],
        "shields_up": [0, 160, 255],
        "hit": [255, 30, 30],
        "kill": [0, 255, 0],
        "overheat": [255, 90, 0],
        "died": [255, 0, 0],
        "docked": [200, 200, 255],
        "docking_ok": [0, 255, 80],
        "docking_no": [255, 40, 0],
        "srv": [0, 200, 160],
        "low_oxygen": [0, 120, 255]
      },
      "label": "Lightbar colours",
      "groups": {
        "hull": { "title": "Hull and health", "order": 1 },
        "travel": { "title": "Travel", "order": 2 },
        "combat": { "title": "Combat", "order": 3 },
        "docking": { "title": "Docking", "order": 4 },
        "srv_foot": { "title": "SRV and on foot", "order": 5 }
      },
      "entries": {
        "hull_full": { "label": "Hull full", "help": "Your hull at 100%, or your health on foot.", "group": "hull", "pattern": "Steady" },
        "hull_half": { "label": "Hull half", "help": "At 50%.", "group": "hull", "pattern": "Steady" },
        "hull_low": { "label": "Hull low", "help": "At 20% and below.", "group": "hull", "pattern": "Steady" },
        "supercruise": { "label": "Supercruise", "help": "The colour in supercruise.", "group": "travel", "pattern": "Steady" },
        "hyperspace": { "label": "Hyperspace", "help": "The jump countdown and the jump, breathing.", "group": "travel", "pattern": "Breathing" },
        "fsd_charge": { "label": "FSD charging", "help": "Rises over 5 s while the FSD charges.", "group": "travel", "pattern": "Rising" },
        "fuel_scoop": { "label": "Fuel scooping", "help": "Breathing while you scoop fuel.", "group": "travel", "pattern": "Breathing" },
        "interdiction": { "label": "Interdiction", "help": "Breathing while you are interdicted.", "group": "travel", "pattern": "Breathing" },
        "jet_cone": { "label": "Jet cone boost", "help": "A flash on a jet cone boost.", "group": "travel", "pattern": "Flash" },
        "shields_down": {
          "label": "Shields down",
          "help": "Blinks while the shields are down, and flashes when they drop.",
          "group": "combat",
          "pattern": "Blink"
        },
        "shields_up": { "label": "Shields up", "help": "A flash when the shields come back.", "group": "combat", "pattern": "Flash" },
        "hit": { "label": "Hit", "help": "A flash on hull damage and attacks.", "group": "combat", "pattern": "Flash" },
        "kill": { "label": "Kill", "help": "A flash on kills, bounties and combat bonds.", "group": "combat", "pattern": "Flash" },
        "overheat": { "label": "Overheating", "help": "Blinks while overheating, and flashes on heat warnings.", "group": "combat", "pattern": "Blink" },
        "died": { "label": "Death", "help": "Blinks for 5 s when you die.", "group": "combat", "pattern": "Blink" },
        "docked": { "label": "Docked", "help": "A dim colour while docked or landed.", "group": "docking", "pattern": "Steady, dim" },
        "docking_ok": { "label": "Docking granted", "help": "A flash.", "group": "docking", "pattern": "Flash" },
        "docking_no": { "label": "Docking denied", "help": "A flash.", "group": "docking", "pattern": "Flash" },
        "srv": { "label": "SRV", "help": "The colour in the SRV.", "group": "srv_foot", "pattern": "Steady" },
        "low_oxygen": { "label": "Low oxygen", "help": "Blinks on foot when oxygen runs low.", "group": "srv_foot", "pattern": "Blink" }
      }
    },
    "triggers": {
      "type": "map",
      "role": "trigger_table",
      "needs": "triggers",
      "of": { "type": "trigger" },
