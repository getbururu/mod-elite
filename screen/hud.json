// Elite's cockpit HUD as Bururu's screen reader sees it: the colours,
// where each number, bar and list sits, and what its changes mean.
// Boxes near a number are in that number's glyph heights from its centre;
// areas are parts of the game window.
{
  "screen": 1,
  "name": "HUD",

  // the standard HUD, measured from recorded gameplay; the player's
  // hud_colors setting, colours learned from the screen and the colour
  // matrix of GraphicsConfigurationOverride.xml change them
  "colours": {
    "shield": { "default": "#29c8cf", "label": "shield",
                "match": { "hue_width": 25, "min_sat": 0.25, "min_val": 0.3, "chroma_tol": 0.5 } },
    "heat":   { "default": "#ba6c16", "label": "heat",
                "match": { "hue_width": 18, "min_sat": 0.4, "min_val": 0.4, "chroma_tol": 0.4 } },
    "flame":  { "default": "#931e1b", "label": "flame",
                "match": { "hue_width": 14, "min_sat": 0.67, "min_val": 0.78, "chroma_tol": 0.35 } },
    // hit flashes on the ship hologram; too close to the shield colour
    // they would look like constant hits
    "flash":  { "default": "#3862c1", "label": "hit flash",
                "match": { "hue_width": 22, "min_sat": 0.63, "min_val": 0.66, "chroma_tol": 0.35 },
                "off_near": { "colour": "shield", "distance": 0.35 } },
    // the HUD's main colour: hull %, capacitors, weapon lists
    "main":   { "default": "#d6870c", "aliases": ["hull"],
                "match": { "hue_width": 18, "min_sat": 0.4, "min_val": 0.4, "chroma_tol": 0.4 } }
  },
  "matrix": { "section": "GUIColour", "rows": ["MatrixRed", "MatrixGreen", "MatrixBlue"] },
  "fonts": { "shield": "screen/digits-shield.json", "heat": "screen/digits-heat.json" },

  "parts": {
    // the shield % under the ship hologram, on the right-hand panel
    "shield": {
      "kind": "number", "area": [0.5, 0.5, 0.97, 0.97], "colour": "shield", "font": "shield",
      "follow": { "box": [-18, -12, 27, 10], "search": [4, 0, 32, 16], "min_score": 0.55 },
      "flash": { "colour": "flash", "box": [-11, -11, 11, 0.5], "spread": 6, "level": "splash" },
      "filter": { "near": 3, "need": 3, "max": 100, "min_score": 0.6 },
      "events": {
        // as big as the shield it took, from where the flashes were
        "drop":  { "kind": "shield_hit", "base": 0.25, "div": 12, "pan_ms": 1000, "damage": true },
        "rise":  { "kind": "shield_regen", "base": 1, "gap_ms": 400 },
        // no steady shield % yet: the flash is the hit
        "flash": { "kind": "shield_hit", "base": 0.3, "div": 4, "gap_ms": 120, "unread": true }
      }
    },
    // the heat %, right of the flame icon at the top left of the radar
    "heat": {
      "kind": "number", "area": [0.25, 0.5, 0.65, 0.95], "colour": "heat", "font": "heat",
      "icon": { "colour": "flame", "height": [0.006, 0.03], "ratio": [0.3, 1.5], "fill": [0.15, 0.75],
                "text": [0, -1.3, 6.5, 1.1], "text_start": 1.8, "text_size": [0.6, 1.4] },
      "follow": { "box": [-6, -3, 5, 3], "min_score": 0.55 },
      "filter": { "near": 4, "need": 3, "max": 199, "min_score": 0.6 },
      "events": {
        "notch": { "kind": "heat_notch", "from": 60, "to": 150, "step": 10, "add": -40, "div": 60 }
      }
    },
    // the hull %, below left of the shield %
    "hull": {
      "kind": "number", "near": "shield", "box": [-12, 1.5, -3.5, 9], "at": [-7, 4.8],
      "colour": "main", "font": "shield", "min_score": 0.68, "every": 3,
      "filter": { "near": 6, "need": 3, "max": 100, "min_score": 0.68 },
      "events": { "drop": { "kind": "hull_hit", "base": 0.4, "div": 10 } }
    },
    // the target panel, left of the radar: its shield % with the hull %
    // below right, or the hull % alone once its shields are down
    "target_shield": {
      "kind": "pair", "area": [0.03, 0.5, 0.42, 0.97], "colour": "shield", "font": "shield",
      "min_score": 0.45, "alone_min": 0.75, "every": 2, "offset": 1, "scan_ms": 1000, "forget_ms": 3000,
      "second": { "name": "target_hull", "colour": "main", "box": [3.5, 1.5, 12, 9], "at": [7, 4.8],
                  "min_score": 0.55, "size": 0.9, "alone": [0.78, 0.55],
                  "filter": { "near": 5, "need": 4, "max": 100, "min_score": 0.55 } },
      "follow": { "box": [-14, -13, 16, 11], "misses": 6 },
      "flash": { "colour": "flash", "box": [-11, -11, 11, 0.5], "spread": 6 },
      "filter": { "near": 4, "need": 3, "max": 100, "min_score": 0.45 },
      "events": {
        "flash":       { "kind": "target_hit", "base": 0.4, "div": 5, "gap_ms": 90 },
        "drop":        { "kind": "target_hit", "base": 0.3, "div": 10, "gap_ms": 150 },
        "break":       { "kind": "target_shield_break", "base": 1, "reads": 3, "below": 40 },
        "second_drop": { "kind": "target_hull_hit", "base": 0.4, "div": 8, "gap_ms": 90, "reads": 3 }
      }
    },
    // the throttle's blue zone (the best turn rate): a column of pale blue
    // right of the heat %, with the throttle marker pale beside it while
    // the throttle is in it
    "blue_zone": {
      "kind": "zone", "near": "heat", "box": [12, -3, 26, 16], "min_score": 0.6, "gap_ms": 200,
      "hue": [160, 215], "sat": [0.08, 0.55], "val": 0.5,
      "column": 1.5, "span": [0.15, 0.65], "marker": [0.3, 2.5]
    },
    // the power distributor's capacitors right of the ship hologram
    "capacitors": {
      "kind": "bars", "near": "shield", "box": [6, -9, 26, 7], "colour": "main", "every": 2,
      "names": ["sys", "eng", "wep"],
      "width": [1.0, 2.6], "height": [0.25, 6], "gap": [2, 4.5], "full": 2,
      "lit": { "hue": 20, "sat": 0.55, "val": 0.45 }, "dim": { "hue": 28, "sat": 0.55, "val": 0.12 }
    },
    // the fire group lists on the cockpit struts: SECONDARY (L2) on the
    // left, PRIMARY (R2) on the right; an entry turns red out of range
    "fire_lists": {
      "kind": "lists", "sides": ["l2", "r2"], "area": [0.09, 0.3, 0.68, 0.8],
      "colour": "main", "alert": "flame",
      "match": {
        "full":      { "hue_width": 9,  "min_sat": 0.5, "min_val": 0.85, "chroma_tol": 0.3 },
        "dim":       { "hue_width": 26, "min_sat": 0.5, "min_val": 0.3,  "chroma_tol": 0.5 },
        "alert":     { "hue_width": 16, "min_sat": 0.6, "min_val": 0.9,  "chroma_tol": 0.35 },
        "alert_dim": { "hue_width": 20, "min_sat": 0.6, "min_val": 0.45, "chroma_tol": 0.35 }
      },
      "glyph": [0.005, 0.022],
      // letter widths in glyph heights, measured on 4K captures (letters
      // not seen there are estimated)
      "letters": {
        "A": 0.92, "B": 0.84, "C": 0.85, "D": 0.85, "E": 0.72, "F": 0.70, "G": 0.88, "H": 0.85, "I": 0.18,
        "J": 0.70, "K": 0.82, "L": 0.67, "M": 1.15, "N": 0.93, "O": 0.95, "P": 0.80, "Q": 0.95, "R": 0.82,
        "S": 0.77, "T": 0.78, "U": 0.85, "V": 0.90, "W": 1.25, "X": 0.88, "Y": 0.82, "Z": 0.80,
        "-": 0.35, ".": 0.2, "'": 0.2, "&": 0.9, "/": 0.6,
        "0": 0.75, "1": 0.45, "2": 0.75, "3": 0.75, "4": 0.78, "5": 0.75, "6": 0.75, "7": 0.72, "8": 0.75, "9": 0.75
      },
      "letter": 0.85, "letter_gap": 0.08, "word_gap": 0.55, "icon_width": 1.68,
      // a weapon's ammo line reading RELOADING, and its end
      "events": { "busy": "reload_start", "done": "reload_done" }
    }
  },

  // finding the colours on screen: the shield % and, down left of it,
  // the hull %, each in a strong colour of the panel; then the heat
  // colour near the hull's, by reading the heat %
  "learn": { "part": "shield", "pair": "hull", "dx": [3, 16], "dy": [-10, -2], "also": "heat", "near": 0.45 }
}
